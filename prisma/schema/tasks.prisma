enum Language {
  javascript
  golang
  python
}

model Task {
  id String @id @default(uuid())

  title       String               @unique
  description Json
  language    Language[]
  initialCode LanugageInitalCode[]
  testCases   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([language])
}

model LanugageInitalCode {
  id     String @id @default(uuid())
  
  taskId String

  language Language
  template String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, language])
}
